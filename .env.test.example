# Environment for the automated test suite (`npm run test:db`)
# Copy to `.env.test`. Points at the throwaway MariaDB from docker-compose.test.yml
#
# tests/setup/guard.ts refuses to run if DB_NAME does not end in `_test`

DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=fsi_test
DB_PASSWORD=fsi_test
DB_NAME=fsi_buchhaltung_test
DB_CONN_LIMIT=5

# Privileged user for DDL: schema creation, migrations, audit triggers
DB_AUDIT_SETUP_USER=root
DB_AUDIT_SETUP_PASSWORD=test_root

# Session / auth. Fixed values so session tests are reproducible
SESSION_COOKIE_NAME=fsi_session_test
SESSION_SECRET=test_secret_not_used_in_production
SESSION_INACTIVITY_MINUTES=30
SESSION_MAX_AGE_MINUTES=1440

# Admin bootstrap for the test database
ADMIN_USERNAME=testadmin
ADMIN_PASSWORD=testadmin

# Uploads are written to a per-run temp directory by tests/setup/env.ts
UPLOAD_DIR=./.test-uploads
MAX_UPLOAD_MB=5

# The background dispatchers must stay off — they would fire during the test run
NOTIFICATIONS_DISPATCH_DISABLED=true
MEMBER_LEAVE_DISPATCH_DISABLED=true

# No outbound mail or push from tests
SMTP_HOST=
SMTP_FROM=noreply@test.invalid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CASH_REGISTER_MODE=standalone
APP_BASE_URL=/
